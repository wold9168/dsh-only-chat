{
  "name": "dsh-only-chat",
  "version": "0.1.0",
  "description": "Only Chat for DeepSeek Harness: a sidebar entry that chats with any model without a workspace. Local files stay read-only, and only the newest maxChats chats are kept.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./guard": "./guard.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "guard.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check guard.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.4.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "cordis",
    "chat",
    "only-chat",
    "no-workspace",
    "read-only",
    "agent-preset"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wold9168/dsh-only-chat.git"
  },
  "homepage": "https://github.com/wold9168/dsh-only-chat",
  "bugs": {
    "url": "https://github.com/wold9168/dsh-only-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
